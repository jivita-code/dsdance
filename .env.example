SITE_URL=http://localhost:3001
CMS_ENABLED=true
INQUIRIES_ENABLED=true
EMAIL_ENABLED=false
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=info@dsdanceresearchlab.com
ZOHO_SMTP_APP_PASSWORD=replace-with-zoho-app-password
EMAIL_FROM_NAME=DS Dance Research Lab
EMAIL_FROM_ADDRESS=info@dsdanceresearchlab.com
# Optional: use a separate, monitored address for internal alerts. Do not use
# the same address as EMAIL_FROM_ADDRESS because Zoho flags self-delivery.
INQUIRY_NOTIFICATION_TO=
JPANEL_API_URL=https://jpanel.jivita.lk/api
JPANEL_SITE_SLUG=ds-dance
JPANEL_SITE_API_KEY=replace-with-site-inquiry-key
